# Copy this file to ".env" and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).

# Project ref / URL
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# The "anon" / publishable key (safe to expose in the browser)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Optional: force the OAuth redirect origin (defaults to window.location.origin).
# Set this to your deployed URL in production, e.g. https://app.example.com
# VITE_APP_URL="http://localhost:8080"
